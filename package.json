{
  "name": "analytics-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace ./packages/browser",
    "check": "npm run check --workspace ./packages/browser",
    "test:browser": "npm run test --workspace ./packages/browser",
    "benchmark:browser": "npm run benchmark --workspace ./packages/browser",
    "test:browser:service": "npm run test:service --workspace ./packages/browser"
  }
}
